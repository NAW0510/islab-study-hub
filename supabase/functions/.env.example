# Salin menjadi supabase/functions/.env untuk `supabase functions serve` (lokal).
# File .env TIDAK ikut ke git. Di project remote, isi lewat:
#   npx supabase secrets set VOYAGE_API_KEY=...

# API key Voyage AI (https://dashboard.voyageai.com). Hanya dipakai Edge Function;
# jangan pernah ditaruh di .env.local milik Next.js.
VOYAGE_API_KEY=

# Opsional, hanya untuk pengujian lokal: arahkan ke server tiruan
# (node scripts/voyage-mock.mjs) supaya tidak memakai kuota. Kosongkan untuk
# memakai Voyage yang asli.
# VOYAGE_API_URL=http://host.docker.internal:4010/v1/embeddings
