# Salin file ini menjadi .env.local lalu isi dengan nilai dari
# Supabase Dashboard → Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) — atau legacy "anon" key juga bisa
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Opsional: zona waktu untuk menampilkan tanggal (default Asia/Jakarta)
# NEXT_PUBLIC_TIMEZONE=Asia/Tokyo
